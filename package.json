{
  "name": "straitjacket",
  "version": "0.0.0",
  "license": "BSD-2-Clause",
  "author": "Balajee.R.C",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "check:format": "prettier --check .",
    "check:unused-code": "knip",
    "check:unused-prod-code": "knip --production --strict",
    "check:code-duplication": "jscpd src --min-lines 10 --threshold 0 --ignore \"**/__fixtures__/**\"",
    "check:dependency-rules": "depcruise src --config .dependency-cruiser.cjs",
    "check:vulnerabilities": "aube audit --audit-level moderate",
    "scan:osv": "osv-scanner scan source --lockfile pnpm-lock.yaml:aube-lock.yaml",
    "scan:secrets": "gitleaks git --redact --no-banner .",
    "check": "aube run typecheck && aube run check:format && aube run lint && aube run check:unused-code && aube run check:unused-prod-code && aube run check:code-duplication && aube run check:dependency-rules && aube run test:coverage",
    "fix": "oxlint --fix && prettier --write .",
    "hooks:install": "prek install"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.4.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.0.16",
    "knip": "^6.40.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
