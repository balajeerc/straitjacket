# aube reads this one setting from .npmrc, not from aube-workspace.yaml.
#
# Fail a script run when node_modules is out of date with the lockfile, rather
# than aube's default of installing first. An install from inside a git hook
# rewrites the lockfile in the middle of a commit; failing says "run
# `aube install`" and leaves the decision with a person.
verify-deps-before-run=error
