{
  /*
   * oxlint — the linter. Formatting is Prettier's; nothing here touches it.
   *
   * This file was carried over rule by rule from the ESLint config it replaces:
   * typescript-eslint strict-type-checked + stylistic-type-checked, @eslint/js
   * recommended, eslint-plugin-promise recommended, the curated unicorn and cap
   * rules, and the vitest rules. sonarjs runs as a JS plugin. perfectionist and
   * eslint-plugin-n were dropped; their closest native equivalents are listed
   * under "Closest equivalents" with the rule each one stands in for. What has
   * no equivalent is listed in `agent_rules/03-code-walkthrough.md`.
   *
   * Type-aware rules run on `oxlint-tsgolint`, which is built on the
   * TypeScript 7 compiler — the same one `tsc` is.
   */
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": { "node": true, "es2022": true },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "node", "promise"],
  // JS plugins are alpha in oxlint and run in Node, not natively. sonarjs is
  // the one we load: nothing native covers cognitive complexity, ReDoS, or its
  // Node security rules.
  "jsPlugins": ["eslint-plugin-sonarjs"],
  /*
   * On top of the explicit list: every rule oxlint itself files as
   * "correctness" — code that is outright wrong.
   */
  "categories": { "correctness": "error" },
  "options": {
    "typeAware": true,
    // A warning is a failure; the severity only changes the wording.
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["dist", "coverage", "reports", ".stryker-tmp"],
  "rules": {
    // Caps and bans, curated
    "eslint/complexity": ["error", { "max": 10 }],
    "eslint/max-depth": ["error", { "max": 3 }],
    "eslint/no-promise-executor-return": ["error", { "allowVoid": false }],
    "promise/prefer-await-to-then": "error",

    // From typescript-eslint strict-type-checked + stylistic-type-checked
    "eslint/constructor-super": "error",
    "eslint/getter-return": ["error", { "allowImplicit": false }],
    "eslint/no-class-assign": "error",
    "eslint/no-const-assign": "error",
    "eslint/no-dupe-class-members": "error",
    "eslint/no-dupe-keys": "error",
    "eslint/no-func-assign": "error",
    "eslint/no-import-assign": "error",
    "eslint/no-new-native-nonconstructor": "error",
    "eslint/no-obj-calls": "error",
    "eslint/no-redeclare": ["error", { "builtinGlobals": true }],
    "eslint/no-setter-return": "error",
    "eslint/no-this-before-super": "error",
    "eslint/no-undef": ["error", { "typeof": false }],
    "eslint/no-unreachable": "error",
    "eslint/no-unsafe-negation": ["error", { "enforceForOrderingRelations": false }],
    "eslint/no-unused-vars": ["error", { "varsIgnorePattern": "^[A-Z_]" }],
    "eslint/no-with": "error",

    // From @eslint/js recommended
    "eslint/for-direction": "error",
    "eslint/no-async-promise-executor": "error",
    "eslint/no-case-declarations": "error",
    "eslint/no-compare-neg-zero": "error",
    "eslint/no-cond-assign": ["error", "except-parens"],
    "eslint/no-constant-binary-expression": "error",
    "eslint/no-constant-condition": ["error", { "checkLoops": "allExceptWhileTrue" }],
    "eslint/no-control-regex": "error",
    "eslint/no-debugger": "error",
    "eslint/no-delete-var": "error",
    "eslint/no-dupe-else-if": "error",
    "eslint/no-duplicate-case": "error",
    "eslint/no-empty": ["error", { "allowEmptyCatch": false }],
    "eslint/no-empty-character-class": "error",
    "eslint/no-empty-pattern": ["error", { "allowObjectPatternsAsParameters": false }],
    "eslint/no-empty-static-block": "error",
    "eslint/no-ex-assign": "error",
    "eslint/no-extra-boolean-cast": ["error", {}],
    "eslint/no-fallthrough": [
      "error",
      { "allowEmptyCase": false, "reportUnusedFallthroughComment": false }
    ],
    "eslint/no-global-assign": ["error", { "exceptions": [] }],
    "eslint/no-invalid-regexp": ["error", {}],
    "eslint/no-irregular-whitespace": [
      "error",
      {
        "skipComments": false,
        "skipJSXText": false,
        "skipRegExps": false,
        "skipStrings": true,
        "skipTemplates": false
      }
    ],
    "eslint/no-loss-of-precision": "error",
    "eslint/no-misleading-character-class": ["error", { "allowEscape": false }],
    "eslint/no-nonoctal-decimal-escape": "error",
    "eslint/no-prototype-builtins": "error",
    "eslint/no-regex-spaces": "error",
    "eslint/no-self-assign": ["error", { "props": true }],
    "eslint/no-shadow-restricted-names": ["error", { "reportGlobalThis": false }],
    "eslint/no-sparse-arrays": "error",
    "eslint/no-unsafe-finally": "error",
    "eslint/no-unsafe-optional-chaining": ["error", { "disallowArithmeticOperators": false }],
    "eslint/no-unused-labels": "error",
    "eslint/no-unused-private-class-members": "error",
    "eslint/no-useless-backreference": "error",
    "eslint/no-useless-catch": "error",
    "eslint/no-useless-escape": ["error", { "allowRegexCharacters": [] }],
    "eslint/require-yield": "error",
    "eslint/use-isnan": ["error", { "enforceForIndexOf": false, "enforceForSwitchCase": true }],
    "eslint/valid-typeof": ["error", { "requireStringLiterals": false }],

    // From eslint-plugin-promise recommended
    "promise/always-return": "error",
    "promise/catch-or-return": "error",
    "promise/no-callback-in-promise": "warn",
    "promise/no-nesting": "warn",
    "promise/no-new-statics": "error",
    "promise/no-promise-in-callback": "warn",
    "promise/no-return-in-finally": "warn",
    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "promise/valid-params": "warn",

    // unicorn, curated
    "unicorn/catch-error-name": ["error", {}],
    "unicorn/error-message": "error",
    "unicorn/escape-case": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/filename-case": ["error", { "case": "camelCase", "ignore": ["^[A-Z].*\\.jsx?$"] }],
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-console-spaces": "error",
    "unicorn/no-lonely-if": "error",
    "unicorn/no-useless-undefined": ["error", {}],
