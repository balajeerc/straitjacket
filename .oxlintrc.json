    "unicorn/prefer-includes": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-spread": "error",
    "unicorn/prefer-string-starts-ends-with": "error",
    "unicorn/throw-new-error": "error",

    // Other
    "node/no-exports-assign": "error",

    // Closest equivalents for rules oxlint does not implement
    // instead of n/no-process-exit, n/process-exit-as-throw
    "unicorn/no-process-exit": "error",
    // instead of sonarjs/code-eval
    "eslint/no-eval": "error",
    // instead of sonarjs/code-eval
    "eslint/no-new-func": "error",
    // instead of sonarjs/no-dead-store
    "eslint/no-useless-assignment": "error",
    // instead of sonarjs/no-parameter-reassignment
    "eslint/no-param-reassign": "error",
    // instead of sonarjs/no-nested-conditional
    "eslint/no-nested-ternary": "error",
    // instead of sonarjs/no-redundant-jump
    "eslint/no-useless-return": "error",
    // instead of sonarjs/no-identical-expressions
    "eslint/no-self-compare": "error",
    // instead of sonarjs/function-inside-loop
    "eslint/no-loop-func": "error",
    // instead of sonarjs/array-callback-without-return
    "eslint/array-callback-return": "error",
    // instead of sonarjs/constructor-for-side-effects
    "eslint/no-new": "error",
    // instead of sonarjs/prefer-default-last
    "eslint/default-case-last": "error",
    // instead of sonarjs/no-nested-assignment
    "eslint/no-multi-assign": "error",
    // instead of sonarjs/no-primitive-wrappers
    "eslint/no-new-wrappers": "error",
    // instead of sonarjs/no-labels
    "eslint/no-labels": "error",
    // instead of sonarjs/no-redundant-boolean
    "eslint/no-unneeded-ternary": "error",
    // instead of sonarjs/prefer-promise-shorthand
    "unicorn/no-useless-promise-resolve-reject": "error",
    // instead of sonarjs/bitwise-operators — `|` or `&` where `||` or `&&` was
    // meant. Not `eslint/no-bitwise`, which bans bitwise operators outright.
    "oxc/bad-bitwise-operator": "error",
    // instead of sonarjs/void-use. `void promise;` as a statement stays legal:
    // it is how a deliberately unawaited promise is marked for
    // `no-floating-promises`.
    "eslint/no-void": ["error", { "allowAsStatement": true }],
    // A loop whose condition nothing in the body can change. Narrower than
    // sonarjs/updated-loop-counter and misplaced-loop-counter, which stay on.
    "eslint/no-unmodified-loop-condition": "error",
    // instead of perfectionist/sort-named-imports — the names inside one import,
    // not the order of the import statements. That order has no native rule.
    "eslint/sort-imports": ["error", { "ignoreCase": true, "ignoreDeclarationSort": true }],
    /*
     * eslint-plugin-sonarjs, loaded as a JS plugin (see `jsPlugins`). Its whole
     * recommended set, minus the rules a native rule above already covers — those
     * are tagged "instead of sonarjs/…" and stay native. `src/driftGuard.test.ts` fails when a recommended rule is in neither
     * place, so a plugin upgrade cannot add rules nobody looked at.
     *
     * The rules sonarjs marks type-aware run here without type information:
     * oxlint gives JS plugins none. They still catch what the syntax shows (a
     * catastrophic regex literal) and miss what only a type would reveal.
     */
    // Off: both ban the marker outright. Dated deferrals are allowed, and
    // `src/deferredWork.test.ts` is what holds them to their date.
    "sonarjs/fixme-tag": "off",
    "sonarjs/todo-tag": "off",
    // Off: a type alias names a concept even when it adds no structure.
    "sonarjs/redundant-type-aliases": "off",
    // Off: sonarjs's copies of core rules that already run natively elsewhere
    // in this file, under the same name.
    "sonarjs/no-array-delete": "off",
