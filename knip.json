{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/index.ts!"],
  "project": ["src/**/*.ts!"],
  // `@commitlint/cli` is run from `prek.toml`, which knip does not read.
  "ignoreDependencies": ["tsx", "pino-pretty", "@commitlint/cli"],
  // Installed by mise from `mise.toml`, not from npm.
  "ignoreBinaries": ["aube", "gitleaks", "osv-scanner", "prek"],
  "ignoreExportsUsedInFile": true,
  "vitest": {
    "config": ["vitest.config.ts"]
  },
  "commitlint": {
    "config": ["commitlint.config.js"]
  }
}
